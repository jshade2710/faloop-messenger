<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.11.0</Version>
    <AssemblyVersion>0.1.11.0</AssemblyVersion>
    <FileVersion>0.1.11.0</FileVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Bundle the plugin icon. Forward slashes everywhere: DalamudPackager
       uses the Link as the zip entry name, and ZIP entries MUST use '/'
       (a backslash makes extractors treat "Images\Icon.png" as one weird
       filename instead of a folder, so Dalamud can't find the icon). -->
  <ItemGroup>
    <None Include="Images/Icon.png">
      <Link>Images/Icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
