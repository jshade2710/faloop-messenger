<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.6.0</Version>
    <AssemblyVersion>0.1.6.0</AssemblyVersion>
    <FileVersion>0.1.6.0</FileVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Bundle the plugin icon into the build output so DalamudPackager
       includes Images/Icon.png in latest.zip. Dalamud shows the installed
       plugin's icon from this path. -->
  <ItemGroup>
    <None Include="Images\Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Images\Icon.png</Link>
    </None>
  </ItemGroup>
</Project>
